; Flying Tulip settings. Edit this file (right-click the skin > Edit settings) or use "Set wallet" on the skin.
; Rainmeter keeps this file when the skin is updated from a .rmskin package.
[Variables]
; Public wallet address to track (0x + 40 hex characters). Leave empty for market data only.
Wallet=
; Warning notification at or below this health factor. Liquidation starts below 1.25.
HfWarn=1.40
; Critical notification at or below this health factor. Keep it above 1.25.
HfCritical=1.30
; Minimum minutes between two notifications of the same level.
NotifyCooldownMin=30
; 1 shows a Windows toast notification on a crossing, 0 only shows the warning colours on the skin.
Notifications=1
; Chain whose FT-ftUSD market price is shown: 1 (Ethereum) or 146 (Sonic).
PriceChainId=1
; Seconds between refreshes (minimum 15).
RefreshSeconds=60
