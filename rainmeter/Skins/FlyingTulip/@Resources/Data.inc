; WebParser measures. Each one fetches an endpoint into memory: RegExp (?s)^(.*)$ captures the whole JSON body
; as the measure's string value, then FinishAction calls OnData(key) and the Lua reads it with
; SKIN:GetMeasure(name):GetStringValue(). Nothing is written to disk.
; Generated by tools/gen_data_inc.sh: edit that script, not this file.

[MeasurePrice]
Measure=WebParser
URL=https://api.flyingtulip.com/mm/spot/tickers?chainId=#PriceChainId#
RegExp=(?s)^(.*)$
StringIndex=1
UpdateRate=#RefreshSeconds#
Flags=ForceReload|NoCookies|NoCacheWrite
Header=Accept: application/json
UserAgent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) FlyingTulipRainmeter/1.4.0
Group=Data
FinishAction=[!CommandMeasure MeasureScript "OnData('price')"]
OnConnectErrorAction=[!CommandMeasure MeasureScript "OnError('price')"]
OnRegExpErrorAction=[!CommandMeasure MeasureScript "OnError('price')"]

