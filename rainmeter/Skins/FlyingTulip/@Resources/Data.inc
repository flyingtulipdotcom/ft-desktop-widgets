; WebParser downloads. Every file is written to DownloadFile\ inside the skin folder and parsed by Lua
; (FinishAction -> OnData). Generated by tools/gen_data_inc.sh: edit that script, not this file.

[MeasurePrice]
Measure=WebParser
URL=https://api.flyingtulip.com/mm/spot/tickers?chainId=#PriceChainId#
Download=1
DownloadFile=price.json
UpdateRate=#RefreshSeconds#
DynamicVariables=1
UserAgent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) FlyingTulipRainmeter/1.0
Group=Data
FinishAction=[!CommandMeasure MeasureScript "OnData('price')"]
OnConnectErrAction=[!CommandMeasure MeasureScript "OnError('price')"]
OnDownloadErrAction=[!CommandMeasure MeasureScript "OnError('price')"]

